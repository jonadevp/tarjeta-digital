{
  "extends": "astro/tsconfigs/strict",
  
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@icons/*": [
        "./src/components/icons/*"
      ],
      "@sections/*": [
        "./src/components/sections/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@constants": [
        "./src/constants/*"
      ]
    },
  }
}
