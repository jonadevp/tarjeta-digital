---
interface Props {
  title: string;
  description: string;
  idealFor: string;
  features: string[];
  icon: string;
  href: string;
  badge?: string;
}

const { title, description, idealFor, features, icon, href, badge } = Astro.props;
---

<article
  class:list={[
    "group relative flex flex-col rounded-2xl border bg-white/60 p-6 backdrop-blur transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-500/10 dark:bg-slate-800/40",
    badge
      ? "border-indigo-500/50 shadow-lg shadow-indigo-500/10 dark:border-indigo-400/40"
      : "border-slate-200 hover:border-indigo-400/50 dark:border-slate-700/60",
  ]}
>
  {
    badge && (
      <span class="absolute -top-3 left-6 rounded-full bg-linear-to-r from-indigo-500 to-fuchsia-500 px-3 py-1 text-xs font-semibold text-white shadow">
        {badge}
      </span>
    )
  }

  <div
    class="grid size-12 place-items-center rounded-xl bg-indigo-500/15 text-indigo-600 transition group-hover:bg-indigo-500 group-hover:text-white dark:text-indigo-300"
  >
    <svg
      class="size-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icon}
    />
  </div>

  <h3 class="mt-5 font-display text-xl font-semibold text-slate-900 dark:text-white">
    {title}
  </h3>
  <p class="mt-1 text-xs font-medium tracking-wide text-indigo-600 uppercase dark:text-indigo-300">
    Ideal para {idealFor}
  </p>
  <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
    {description}
  </p>

  <ul class="mt-5 flex-1 space-y-2.5 border-t border-slate-200 pt-5 text-sm dark:border-slate-700/60">
    {
      features.map((feature) => (
        <li class="flex items-start gap-2.5 text-slate-700 dark:text-slate-300">
          <svg
            class="mt-0.5 size-4 shrink-0 text-emerald-500"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z"
              clip-rule="evenodd"
            />
          </svg>
          {feature}
        </li>
      ))
    }
  </ul>

  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "mt-6 inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition",
      badge
        ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/30 hover:bg-indigo-500"
        : "border border-slate-300 text-slate-800 hover:border-indigo-400 hover:text-indigo-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-indigo-400 dark:hover:text-indigo-300",
    ]}
  >
    Cotizar {title.toLowerCase()}
    <span class="sr-only">por WhatsApp</span>
  </a>
</article>
