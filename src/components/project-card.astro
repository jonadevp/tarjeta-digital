---
import type { Project } from "@/types/project";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const { title, category, description, tags, url, image, kind } = project;

const isConceptual = kind === "conceptual";

const gradients = [
  "from-indigo-500 via-violet-500 to-fuchsia-500",
  "from-sky-500 via-indigo-500 to-violet-500",
  "from-fuchsia-500 via-rose-500 to-amber-400",
];
const gradient = gradients[index % gradients.length];
---

<article
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white/60 backdrop-blur transition duration-300 dark:border-slate-700/60 dark:bg-slate-800/40",
    !isConceptual &&
      "hover:-translate-y-1 hover:border-indigo-400/50 hover:shadow-xl hover:shadow-indigo-500/10",
  ]}
>
  <!-- Vista previa -->
  <div
    class="relative aspect-16/10 overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-slate-700/60 dark:bg-slate-900"
  >
    {
      image ? (
        <img
          src={image}
          alt={`Vista previa de ${title}`}
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
          class:list={[
            "size-full object-cover object-top transition duration-500",
            !isConceptual && "group-hover:scale-105",
          ]}
        />
      ) : (
        <div aria-hidden="true" class="flex size-full flex-col p-4">
          <div class="flex items-center gap-1 pb-3">
            <span class="size-2 rounded-full bg-rose-400" />
            <span class="size-2 rounded-full bg-amber-400" />
            <span class="size-2 rounded-full bg-emerald-400" />
          </div>
          <div
            class:list={[
              "flex flex-1 flex-col justify-end rounded-lg bg-linear-to-br p-4 transition duration-500",
              gradient,
              !isConceptual && "group-hover:scale-[1.03]",
            ]}
          >
            <p class="font-display text-lg leading-tight font-bold text-white">{title}</p>
            <div class="mt-2 h-1.5 w-2/3 rounded-full bg-white/60" />
            <div class="mt-3 h-5 w-20 rounded-md bg-white/90" />
          </div>
        </div>
      )
    }

   { isConceptual && (

     <span
       class="absolute top-3 right-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-slate-700 capitalize shadow-sm backdrop-blur dark:bg-slate-900/80 dark:text-slate-200"
     >
       {kind}
     </span>
   )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-medium tracking-wide text-indigo-600 uppercase dark:text-indigo-300">
      {category}
    </p>
    <h3 class="mt-1 font-display text-lg font-semibold text-slate-900 dark:text-white">
      {title}
    </h3>
    <p class="mt-2 flex-1 text-sm text-slate-600 dark:text-slate-400">{description}</p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
      {
        tags.map((tag) => (
          <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-700/50 dark:text-slate-300">
            {tag}
          </li>
        ))
      }
    </ul>

    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 after:absolute after:inset-0 hover:text-indigo-500 dark:text-indigo-300"
        >
          Ver proyecto
          <span class="sr-only">{title}</span>
          <svg
            class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M5.22 14.78a.75.75 0 0 1 0-1.06l7.22-7.22H7.75a.75.75 0 0 1 0-1.5h6.5a.75.75 0 0 1 .75.75v6.5a.75.75 0 0 1-1.5 0V7.56l-7.22 7.22a.75.75 0 0 1-1.06 0Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>