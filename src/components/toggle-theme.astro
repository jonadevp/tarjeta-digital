---
const THEMES = ["Light", "Dark", "System"];
import Sun from "@icons/sun.astro";
import System from "@icons/system.astro";
import Moon from "@icons/moon.astro";
---

<>
  <button
    type="button"
    id="theme-toggle-btn"
    class="appearance-none border-none flex hover:scale-125 transition text-slate-700 dark:text-white/90"
  >
    <span class="sr-only">Elige un tema</span>
    <Sun id="light" class="theme-icon size-6" />
    <System id="system" class="theme-icon absolute size-6" />
    <Moon id="dark" class="theme-icon absolute size-6" />
  </button>

  <div
    id="themes-menu"
    class="absolute top-full right-0 hidden text-sm p-1 max-w-[calc(100vw-2rem)] w-56 rounded-md shadow bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-500/20 backdrop-blur-md"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li>
            <button
              type="button"
              data-theme={theme.toLowerCase()}
              class="themes-menu-option w-full text-left cursor-pointer z-50 px-2 py-1.5 hover:bg-slate-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            >
              {theme}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</>

<style>
  .theme-icon {
    scale: 0;
  }

  :global(html[data-theme="light"]) #light,
  :global(html[data-theme="dark"]) #dark,
  :global(html[data-theme="system"]) #system {
    scale: 1;
  }

  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  type ThemePreference = "dark" | "light" | "system";

  const DARK: ThemePreference = "dark";
  const SYSTEM: ThemePreference = "system";
  const THEME_STORAGE_KEY = "theme";

  let remove: (() => void) | null = null;
  // detecta la preferencia de colores del sistema operativo
  const matchMedia = window.matchMedia("(prefers-color-scheme: dark)");
  const themesMenu = document.getElementById("themes-menu") as HTMLDivElement;
  const toggleBtn = document.getElementById("theme-toggle-btn");

  const getThemePreference = (): ThemePreference => {
    try {
      return (
        (localStorage.getItem(THEME_STORAGE_KEY) as ThemePreference) ?? SYSTEM
      );
    } catch {
      return SYSTEM;
    }
  };

  const updateIcon = (themePreference: ThemePreference): void => {
    document.documentElement.dataset.theme = themePreference;
  };

  const updateTheme = (): void => {
    if (remove != null) {
      remove();
    }

    matchMedia.addEventListener("change", updateTheme);
    remove = () => {
      matchMedia.removeEventListener("change", updateTheme);
    };

    const themePreference = getThemePreference();
    const isDark =
      themePreference === DARK ||
      (themePreference === SYSTEM && matchMedia.matches);

    updateIcon(themePreference);
    document.documentElement.classList.toggle("dark", isDark);
  };

  updateTheme();

  // Cierra el menú al hacer clic en cualquier parte
  document.addEventListener("click", () => {
    themesMenu.classList.remove("open");
  });

  // Abre / cierra el menú con el botón
  toggleBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    themesMenu.classList.toggle("open");
  });

  // Elige el tema desde el menú
  document
    .querySelectorAll<HTMLButtonElement>(".themes-menu-option")
    .forEach((element) => {
      element.addEventListener("click", (e) => {
        const theme = (e.currentTarget as HTMLElement).dataset
          .theme as ThemePreference;
        try {
          localStorage.setItem(THEME_STORAGE_KEY, theme);
        } catch {}
        updateTheme();
      });
    });
</script>