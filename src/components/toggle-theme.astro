---
import Sun from "@icons/sun.astro";
import System from "@icons/system.astro";
import Moon from "@icons/moon.astro";

const THEMES = [
  { value: "light", label: "Claro" },
  { value: "dark", label: "Oscuro" },
  { value: "system", label: "Sistema" },
];
---

<>
  <button
    type="button"
    id="theme-toggle-btn"
    aria-expanded="false"
    aria-controls="themes-menu"
    class="appearance-none border-none flex hover:scale-125 transition motion-reduce:transition-none motion-reduce:hover:scale-100 text-slate-700 dark:text-white/90"
  >
    <span id="theme-toggle-label" class="sr-only">Elige un tema</span>
    <Sun id="theme-icon-light" class="theme-icon size-6" aria-hidden="true" />
    <System id="theme-icon-system" class="theme-icon absolute size-6" aria-hidden="true" />
    <Moon id="theme-icon-dark" class="theme-icon absolute size-6" aria-hidden="true" />
  </button>

  <div
    id="themes-menu"
    class="absolute top-full right-0 hidden text-sm p-1 max-w-[calc(100vw-2rem)] w-56 rounded-md shadow bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-500/20 backdrop-blur-md"
  >
    <ul>
      {
        THEMES.map(({ value, label }) => (
          <li>
            <button
              type="button"
              data-theme={value}
              aria-pressed="false"
              class="themes-menu-option w-full text-left cursor-pointer px-2 py-1.5 hover:bg-slate-400/40 dark:hover:bg-gray-500/50 rounded-sm"
            >
              {label}
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</>

<style>
  .theme-icon {
    scale: 0;
  }

  :global(html[data-theme="light"]) #theme-icon-light,
  :global(html[data-theme="dark"]) #theme-icon-dark,
  :global(html[data-theme="system"]) #theme-icon-system {
    scale: 1;
  }

  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #themes-menu.open {
      animation: none;
    }
  }
</style>

<script>
  type ThemePreference = "dark" | "light" | "system";

  const THEME_STORAGE_KEY = "theme";
  const LABELS = { light: "claro", dark: "oscuro", system: "del sistema" } as const;

  const isThemePreference = (value: unknown): value is ThemePreference =>
    value === "light" || value === "dark" || value === "system";

  function initThemeToggle() {
    const themesMenu = document.getElementById("themes-menu");
    const toggleBtn = document.getElementById("theme-toggle-btn");
    const toggleLabel = document.getElementById("theme-toggle-label");
    const options = document.querySelectorAll<HTMLButtonElement>(".themes-menu-option");
    if (!themesMenu || !toggleBtn || !toggleLabel) return;

    // Detecta la preferencia de colores del sistema operativo
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");

    const getThemePreference = (): ThemePreference => {
      try {
        const stored = localStorage.getItem(THEME_STORAGE_KEY);
        return isThemePreference(stored) ? stored : "system";
      } catch {
        return "system";
      }
    };

    // Refleja el tema activo en el ícono, en el texto del botón y en las opciones
    const updateUI = (pref: ThemePreference) => {
      document.documentElement.dataset.theme = pref;
      toggleLabel.textContent = `Tema: ${LABELS[pref]}. Elige un tema`;
      options.forEach((option) =>
        option.setAttribute("aria-pressed", String(option.dataset.theme === pref)),
      );
    };

    const updateTheme = () => {
      const pref = getThemePreference();
      const isDark = pref === "dark" || (pref === "system" && prefersDark.matches);
      document.documentElement.classList.toggle("dark", isDark);
      updateUI(pref);
    };

    const setMenuOpen = (open: boolean) => {
      themesMenu.classList.toggle("open", open);
      toggleBtn.setAttribute("aria-expanded", String(open));
    };

    prefersDark.addEventListener("change", updateTheme);
    updateTheme();

    // Abre / cierra el menú con el botón
    toggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      setMenuOpen(!themesMenu.classList.contains("open"));
    });

    // Cierra el menú al hacer clic en cualquier parte
    document.addEventListener("click", () => setMenuOpen(false));

    // Cierra con Escape y devuelve el foco al botón
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && themesMenu.classList.contains("open")) {
        setMenuOpen(false);
        toggleBtn.focus();
      }
    });

    // Elige el tema desde el menú
    options.forEach((option) => {
      option.addEventListener("click", () => {
        const theme = option.dataset.theme;
        if (!isThemePreference(theme)) return;
        try {
          localStorage.setItem(THEME_STORAGE_KEY, theme);
        } catch {}
        updateTheme();
        setMenuOpen(false);
        toggleBtn.focus();
      });
    });
  }

  initThemeToggle();
</script>