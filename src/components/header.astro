---
import ToggleTheme from "@components/toggle-theme.astro";
---

<header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-800 bg-white/30 dark:bg-slate-900/50 backdrop-blur-md"> 

    <div class="max-w-5xl relative h-16 mx-auto px-4 sm:px-6 lg:px-2 flex items-center justify-between">

        <div class="logo shrink-0 ">
            <a href="/" class="text-slate-900 dark:text-white text-base font-bold font-display">Jonadevp</a>

        </div>

        <div class="theme relative">
           <ToggleTheme />
        </div>
        
    </div>

</header>