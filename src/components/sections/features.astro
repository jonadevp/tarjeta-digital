---
import SectionContainer from "@components/section-container.astro";
import FeatureCard from "@components/feature-card.astro";
import { features } from "@data/features";
---

<SectionContainer
  id="incluye"
  labelledby="incluye-title"
  class="max-w-4xl scroll-mt-20"
>
  <h2
    id="incluye-title"
    class="text-center font-display text-3xl font-bold tracking-tight text-balance text-slate-900 sm:text-4xl dark:text-white"
  >
    Todo lo que incluye tu página
  </h2>
  <p class="mx-auto mt-3 max-w-md text-center text-slate-600 dark:text-slate-400">
    Esto es lo que va dentro de tu paquete.
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => <FeatureCard {...feature} />)}
  </div>
</SectionContainer>