---
import SectionContainer from "@components/section-container.astro";

const WHATSAPP_NUMBER = "522741151616";
const whatsappMessage = encodeURIComponent(
  "Hola Jonathan, vi tu tarjeta y quiero cotizar una página web.",
);
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${whatsappMessage}`;

const services = ["Landing pages", "Blogs", "Sitios informativos"];

const highlights = [
  { value: "100%", label: "Responsive" },
  { value: "SEO", label: "Optimizado" },
  { value: "1:1", label: "Trato directo" },
];
---
<SectionContainer class="relative isolate overflow-hidden pt-16 sm:pt-20"> 
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <!-- Fondo: cuadrícula + destellos de color -->

    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgb(148_163_184/0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgb(148_163_184/0.12)_1px,transparent_1px)] bg-size-[40px_40px] mask-[radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"
    >
    </div>
    <div
      class="absolute -top-32 left-1/2 size-112 -translate-x-1/2 rounded-full bg-indigo-500/25 blur-3xl dark:bg-indigo-500/20"
    >
    </div>
    <div
      class="absolute top-40 -right-24 size-72 rounded-full bg-fuchsia-400/20 blur-3xl dark:bg-fuchsia-500/15"
    >
    </div>
  </div>

  <div class="mx-auto grid max-w-5xl items-center gap-14 md:grid-cols-[1.1fr_1fr] md:gap-10">
    <!-- Texto -->
    <div class="text-center md:text-left text-pretty">
      <p
        class="hero-reveal inline-flex items-center gap-2 rounded-full border border-indigo-500/20 bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-700 dark:text-indigo-300"
      >
        <span class="relative flex size-2">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
        </span>
        Disponible para nuevos proyectos
      </p>

      <h1
        class="hero-reveal mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-balance text-slate-900 sm:text-5xl dark:text-white"
        style="--delay: 80ms"
      >
         Tu página web,{" "}
        <span
          class="bg-linear-to-r from-indigo-500 via-violet-500 to-fuchsia-500 bg-clip-text text-transparent">lista en pocos días
        </span>
      </h1>

      <p
        class="hero-reveal mx-auto mt-5 max-w-md text-base text-pretty text-slate-600 sm:text-lg md:mx-0 dark:text-slate-400"
        style="--delay: 160ms"
      >
        Diseño y desarrollo sitios rápidos, modernos y listos para celular, para que
        tus clientes te encuentren y te contacten en un clic.
      </p>

      <ul
        class="hero-reveal mt-6 flex flex-wrap justify-center gap-2 md:justify-start"
        style="--delay: 220ms"
        aria-label="Servicios"
      >
        {
          services.map((service) => (
            <li class="rounded-lg border border-slate-200 bg-white/60 px-3 py-1 text-sm text-slate-700 backdrop-blur dark:border-slate-700/60 dark:bg-slate-800/40 dark:text-slate-300">
              {service}
            </li>
          ))
        }
      </ul>

      <div
        class="hero-reveal mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start"
        style="--delay: 300ms"
      >
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 transition hover:-translate-y-0.5 hover:bg-indigo-500 hover:shadow-indigo-500/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35ZM12.04 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.35-.2-3.58.93.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.91.99 6.7 2.78a9.41 9.41 0 0 1 2.77 6.7c0 5.22-4.25 9.46-9.47 9.46Zm8.06-17.53A11.33 11.33 0 0 0 12.04.63C5.76.63.65 5.74.65 12.02c0 2.01.52 3.97 1.52 5.69L.55 23.62l6.04-1.58a11.36 11.36 0 0 0 5.44 1.39h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.19-5.9-3.33-8.05Z"
            ></path>
          </svg>
          Cotiza por WhatsApp
        </a>
        <a
          href="#servicios"
          class="group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white/70 px-6 py-3 text-sm font-semibold text-slate-800 backdrop-blur transition hover:-translate-y-0.5 hover:border-indigo-400 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-900/50 dark:text-slate-200 dark:hover:border-indigo-400 dark:hover:text-indigo-300"
        >
          Ver servicios
          <svg
            class="size-4 transition-transform group-hover:translate-x-1"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.64l-4.22-4.22a.75.75 0 1 1 1.06-1.06l5.5 5.5a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 1 1-1.06-1.06l4.22-4.22H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>

      <dl
        class="hero-reveal mt-10 grid grid-cols-3 divide-x divide-slate-200 border-t border-slate-200 pt-6 dark:divide-slate-800 dark:border-slate-800"
        style="--delay: 380ms"
      >
        {
          highlights.map(({ value, label }) => (
            <div class="flex flex-col-reverse items-center gap-0.5 px-2 md:items-start md:first:pl-0 md:px-4">
              <dt class="text-xs text-slate-600 dark:text-slate-300">{label}</dt>
              <dd class="font-display text-xl font-bold text-slate-900 dark:text-white">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Visual: mockup de navegador -->
    <div class="hero-reveal relative mx-auto w-full max-w-sm md:max-w-none" style="--delay: 200ms" aria-hidden="true">
      <div
        class="hero-float relative rounded-2xl border border-slate-200 bg-white/80 shadow-2xl shadow-indigo-500/10 backdrop-blur-xl dark:border-slate-700/60 dark:bg-slate-900/70"
      >
        <div class="flex items-center gap-1.5 border-b border-slate-200 px-4 py-3 dark:border-slate-700/60">
          <span class="size-2.5 rounded-full bg-rose-400"></span>
          <span class="size-2.5 rounded-full bg-amber-400"></span>
          <span class="size-2.5 rounded-full bg-emerald-400"></span>
          <span
            class="ml-3 flex-1 truncate rounded-md bg-slate-100 px-3 py-1 text-[11px] text-slate-700 dark:bg-slate-800 dark:text-slate-400"
          >
            tupagina.com
          </span>
        </div>

        <div class="space-y-4 p-5">
          <div class="h-28 rounded-xl bg-linear-to-br from-indigo-500 via-violet-500 to-fuchsia-500 p-4">
            <div class="h-2.5 w-2/3 rounded-full bg-white/80"></div>
            <div class="mt-2 h-2.5 w-1/2 rounded-full bg-white/60"></div>
            <div class="mt-5 h-6 w-24 rounded-md bg-white/90"></div>
          </div>
          <div class="grid grid-cols-3 gap-3">
            {
              [0, 1, 2].map(() => (
                <div class="space-y-2 rounded-lg border border-slate-200 p-2.5 dark:border-slate-700/60">
                  <div class="size-5 rounded-md bg-indigo-500/20" />
                  <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-700" />
                  <div class="h-1.5 w-2/3 rounded-full bg-slate-200 dark:bg-slate-700" />
                </div>
              ))
            }
          </div>
          <div class="space-y-2">
            <div class="h-1.5 w-full rounded-full bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-1.5 w-5/6 rounded-full bg-slate-200 dark:bg-slate-700"></div>
            <div class="h-1.5 w-4/6 rounded-full bg-slate-200 dark:bg-slate-700"></div>
          </div>
        </div>
      </div>

      <!-- Tarjetas flotantes -->
      <div
        class="hero-float-alt absolute -bottom-6 -left-4 flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-xl sm:-left-8 dark:border-slate-700/60 dark:bg-slate-900"
      >
        <span class="grid size-9 place-items-center rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400">
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M12.58 4.58a.75.75 0 0 1 .75-.75h3.34a.75.75 0 0 1 .75.75v3.34a.75.75 0 0 1-1.5 0V6.39l-4.6 4.6a.75.75 0 0 1-1.06 0L7.92 8.66 3.86 12.7a.75.75 0 1 1-1.06-1.06l4.6-4.6a.75.75 0 0 1 1.06 0l2.33 2.33 4.07-4.07h-1.53a.75.75 0 0 1-.75-.75Z"
              clip-rule="evenodd"></path>
          </svg>
        </span>
        <div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">Sin costo</p>
          <p class="font-display text-sm font-bold text-slate-900 dark:text-white">DEMO EN VIVO</p>
        </div>
      </div>

      <div
        class="hero-float absolute -top-5 -right-3 flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-xl sm:-right-6 dark:border-slate-700/60 dark:bg-slate-900"
        style="animation-delay: -2s"
      >
        <!-- <span class="grid size-7 place-items-center rounded-full bg-indigo-500/15 font-display text-xs font-bold text-indigo-600 dark:text-indigo-300">
          90
        </span> -->
        <p class="text-[11px] font-medium text-slate-600 dark:text-slate-300">Carga rápida</p>
      </div>
    </div>
  </div>
</SectionContainer>

<style>
  .hero-reveal {
    animation: hero-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--delay, 0ms);
  }

  .hero-float {
    animation: hero-float 6s ease-in-out infinite;
  }

  .hero-float-alt {
    animation: hero-float 7s ease-in-out infinite reverse;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-float,
    .hero-float-alt {
      animation: none;
    }
  }
</style>
