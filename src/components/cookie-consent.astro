<script>
  import "vanilla-cookieconsent/dist/cookieconsent.css";
  import * as CookieConsent from "vanilla-cookieconsent";

  // --- Tema: el banner sigue tu modo claro/oscuro ---
  const root = document.documentElement;
  const syncTheme = () =>
    root.classList.toggle("cc--darkmode", root.classList.contains("dark"));

  syncTheme();
  new MutationObserver(syncTheme).observe(root, {
    attributes: true,
    attributeFilter: ["class"],
  });

  // --- Google Analytics: solo se carga si se acepta la categoría "analytics" ---
  const GA_ID = "G-LW6G6954PT";

  type GtagWindow = Window & { dataLayer?: unknown[] };
  const w = window as GtagWindow;

  function gtag(..._args: unknown[]) {
    // gtag.js espera recibir el objeto "arguments", no un arreglo
    w.dataLayer?.push(arguments);
  }

  const loadGoogleAnalytics = () => {
    if (document.getElementById("ga-script")) return;

    w.dataLayer = w.dataLayer || [];

    const script = document.createElement("script");
    script.id = "ga-script";
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(script);

    gtag("js", new Date());
    gtag("config", GA_ID);
  };

  // --- Banner ---
  CookieConsent.run({
    onConsent: () => {
      if (CookieConsent.acceptedCategory("analytics")) loadGoogleAnalytics();
    },
    onChange: () => {
      if (CookieConsent.acceptedCategory("analytics")) loadGoogleAnalytics();
    },

    categories: {
      necessary: {
        enabled: true,
        readOnly: true,
      },
      analytics: {
        enabled: false,
        autoClear: {
          cookies: [{ name: /^_ga/ }],
          reloadPage: true,
        },
      },
    },

    guiOptions: {
      consentModal: {
        layout: "cloud inline",
        position: "bottom center",
        equalWeightButtons: true,
        flipButtons: false,
      },
      preferencesModal: {
        layout: "box",
        equalWeightButtons: true,
        flipButtons: false,
      },
    },

    language: {
      default: "es",
      translations: {
        es: {
          consentModal: {
            title: "Cookies",
            description:
              'Uso cookies de estadística (Google Analytics) solo si lo aceptas, para saber cuántas personas visitan este sitio y de dónde llegan. Puedes cambiar tu decisión cuando quieras. Más información en el <a href="/legal/privacidad">aviso de privacidad</a>.',
            acceptAllBtn: "Aceptar todas",
            acceptNecessaryBtn: "Solo necesarias",
            showPreferencesBtn: "Personalizar",
          },
          preferencesModal: {
            title: "Preferencias de cookies",
            acceptAllBtn: "Aceptar todas",
            acceptNecessaryBtn: "Solo necesarias",
            savePreferencesBtn: "Guardar selección",
            closeIconLabel: "Cerrar",
            sections: [
              {
                title: "Tu privacidad",
                description:
                  'Aquí eliges qué cookies permites. Detalles en el <a href="/legal/privacidad">aviso de privacidad</a>.',
              },
              {
                title: "Estrictamente necesarias",
                description:
                  "Permiten que el sitio funcione, por ejemplo recordar tu tema claro u oscuro. No se pueden desactivar.",
                linkedCategory: "necessary",
              },
              {
                title: "Estadística",
                description:
                  "Nos ayudan a saber cuántas personas visitan el sitio y de dónde llegan (Google Analytics). Solo se activan si las aceptas.",
                linkedCategory: "analytics",
              },
            ],
          },
        },
      },
    },
  });
</script>

