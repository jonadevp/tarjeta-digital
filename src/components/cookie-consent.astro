    --cc-btn-primary-hover-bg: #6366f1;
    --cc-btn-primary-hover-border-color: #6366f1;
    --cc-toggle-on-bg: var(--cc-btn-primary-bg);
    --cc-btn-border-radius: 0.75rem;
    --cc-modal-border-radius: 1rem;
  }
</style>